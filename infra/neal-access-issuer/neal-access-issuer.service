[Unit]
Description=NEAL stake-gated Matrix access-token issuer
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/neal-access-issuer.env
LoadCredential=matrix-registration-secret:/srv/neal-matrix/runtime/synapse/registration-shared-secret
LoadCredential=issuer-keypair:/etc/neal-access-issuer-issuer-keypair.json
Environment=NEAL_ACCESS_MATRIX_SECRET_FILE=%d/matrix-registration-secret
Environment=NEAL_ACCESS_ISSUER_KEYPAIR_FILE=%d/issuer-keypair
ExecStart=/opt/neal-access-issuer/venv/bin/python /opt/neal-access-issuer/issuer.py
Restart=on-failure
RestartSec=3
RuntimeDirectory=neal-access-issuer
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=neal-access-issuer
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
