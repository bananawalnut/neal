{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectAndListImmutableBackupVersions",
      "Effect": "Allow",
      "Action": ["s3:GetBucketVersioning", "s3:GetBucketObjectLockConfiguration", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::BUCKET"
    },
    {
      "Sid": "ReadExactImmutableBackupVersions",
      "Effect": "Allow",
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:aws:s3:::BUCKET/neal-access-issuer/*"
    },
    {
      "Sid": "ForbidBackupMutation",
      "Effect": "Deny",
      "Action": ["s3:PutObject*", "s3:DeleteObject*", "s3:BypassGovernanceRetention"],
      "Resource": ["arn:aws:s3:::BUCKET", "arn:aws:s3:::BUCKET/neal-access-issuer/*"]
    }
  ]
}
