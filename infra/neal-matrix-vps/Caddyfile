matrix.nealtheseal.org {
    encode zstd gzip

    @matrix_server_discovery path /.well-known/matrix/server
    handle @matrix_server_discovery {
        header Content-Type "application/json; charset=utf-8"
        header Access-Control-Allow-Origin "*"
        header Cache-Control "public, max-age=300, must-revalidate"
        respond `{"m.server":"matrix.nealtheseal.org:443"}` 200
    }

    @matrix_client_discovery path /.well-known/matrix/client
    handle @matrix_client_discovery {
        header Content-Type "application/json; charset=utf-8"
        header Access-Control-Allow-Origin "*"
        header Cache-Control "public, max-age=300, must-revalidate"
        respond `{"m.homeserver":{"base_url":"https://matrix.nealtheseal.org/"}}` 200
    }

    @synapse_admin path /_synapse/admin /_synapse/admin/*
    handle @synapse_admin {
        header Content-Type "application/json; charset=utf-8"
        header Cache-Control "no-store"
        respond `{"errcode":"M_NOT_FOUND","error":"Not found"}` 404
    }

    @neal_admin_monitor path /_neal/admin/session /_neal/admin/snapshot
    handle @neal_admin_monitor {
        request_body {
            max_size 32KB
        }
        reverse_proxy unix//run/neal-admin-monitor/monitor.sock
    }

    @neal_gc_feed {
        method GET
        path /_neal/gc/messages
    }
    handle @neal_gc_feed {
        rewrite * /_matrix/client/v3/rooms/%21KliLLiEXeNPupDcYwe%3Amatrix.nealtheseal.org/messages?dir=b&limit=100&filter=%7B%22types%22%3A%5B%22m.room.message%22%5D%7D
        header Cache-Control "public, max-age=5, stale-while-revalidate=20"
        reverse_proxy synapse:8008 {
            header_up Authorization "Bearer {$NEAL_GC_READER_TOKEN}"
            header_down -Cache-Control
        }
    }

    @neal_access_preflight {
        method OPTIONS
        path /v1/challenge /v1/verify /v1/access-token /v2/challenge /v2/verify /v2/access-token /v2/registration-stage
        header Origin https://nealtheseal.org
    }
    handle @neal_access_preflight {
        reverse_proxy unix//run/neal-access-issuer/issuer.sock
    }

    @neal_access_post {
        method POST
        path /v1/challenge /v1/verify /v1/access-token /v2/challenge /v2/verify /v2/access-token /v2/registration-stage
        header Origin https://nealtheseal.org
    }
    handle @neal_access_post {
        request_body {
            max_size 32KB
        }
        reverse_proxy unix//run/neal-access-issuer/issuer.sock
    }

    @neal_access_hidden path /v1/challenge /v1/verify /v1/access-token /v2/challenge /v2/verify /v2/access-token /v2/registration-stage /healthz /readyz /metrics
    handle @neal_access_hidden {
        header Content-Type "application/json; charset=utf-8"
        header Cache-Control "no-store"
        respond `{"error":"Not found"}` 404
    }

    handle {
        reverse_proxy synapse:8008
    }
}
