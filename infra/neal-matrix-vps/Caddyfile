matrix.nealtheseal.org {
    encode zstd gzip

    @matrix_server_discovery path /.well-known/matrix/server
    handle @matrix_server_discovery {
        header Content-Type "application/json; charset=utf-8"
        header Access-Control-Allow-Origin "*"
        header Cache-Control "public, max-age=300, must-revalidate"
        respond `{"m.server":"matrix.nealtheseal.org:443"}` 200
    }

    @matrix_client_discovery path /.well-known/matrix/client
    handle @matrix_client_discovery {
        header Content-Type "application/json; charset=utf-8"
        header Access-Control-Allow-Origin "*"
        header Cache-Control "public, max-age=300, must-revalidate"
        respond `{"m.homeserver":{"base_url":"https://matrix.nealtheseal.org/"}}` 200
    }

    @synapse_admin path /_synapse/admin /_synapse/admin/*
    handle @synapse_admin {
        header Content-Type "application/json; charset=utf-8"
        header Cache-Control "no-store"
        respond `{"errcode":"M_NOT_FOUND","error":"Not found"}` 404
    }

    @neal_admin_preflight {
        method OPTIONS
        path /_neal/admin/users /_neal/admin/server
        header Origin https://nealtheseal.org
    }
    handle @neal_admin_preflight {
        header Access-Control-Allow-Origin "https://nealtheseal.org"
        header Access-Control-Allow-Methods "GET, OPTIONS"
        header Access-Control-Allow-Headers "Authorization, Content-Type"
        header Access-Control-Max-Age "600"
        header Vary "Origin"
        header Cache-Control "no-store"
        respond "" 204
    }

    @neal_admin_users {
        method GET
        path /_neal/admin/users
        header Origin https://nealtheseal.org
    }
    handle @neal_admin_users {
        rewrite * /_synapse/admin/v2/users?limit=500
        header Access-Control-Allow-Origin "https://nealtheseal.org"
        header Vary "Origin"
        header Cache-Control "no-store"
        reverse_proxy synapse:8008 {
            header_down -Cache-Control
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Access-Control-Expose-Headers
        }
    }

    @neal_admin_server {
        method GET
        path /_neal/admin/server
        header Origin https://nealtheseal.org
    }
    handle @neal_admin_server {
        rewrite * /_synapse/admin/v1/server_version
        header Access-Control-Allow-Origin "https://nealtheseal.org"
        header Vary "Origin"
        header Cache-Control "no-store"
        reverse_proxy synapse:8008 {
            header_down -Cache-Control
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Access-Control-Expose-Headers
        }
    }

    @neal_gc_feed {
        method GET
        path /_neal/gc/messages
    }
    handle @neal_gc_feed {
        rewrite * /_matrix/client/v3/rooms/%21KliLLiEXeNPupDcYwe%3Amatrix.nealtheseal.org/messages?dir=b&limit=100&filter=%7B%22types%22%3A%5B%22m.room.message%22%5D%7D
        header Cache-Control "public, max-age=5, stale-while-revalidate=20"
        reverse_proxy synapse:8008 {
            header_up Authorization "Bearer {$NEAL_GC_READER_TOKEN}"
            header_down -Cache-Control
        }
    }

    @neal_access_preflight {
        method OPTIONS
        path /v1/challenge /v1/verify /v1/access-token
        header Origin https://nealtheseal.org
    }
    handle @neal_access_preflight {
        reverse_proxy unix//run/neal-access-issuer/issuer.sock
    }

    @neal_access_post {
        method POST
        path /v1/challenge /v1/verify /v1/access-token
        header Origin https://nealtheseal.org
    }
    handle @neal_access_post {
        request_body {
            max_size 32KB
        }
        reverse_proxy unix//run/neal-access-issuer/issuer.sock
    }

    @neal_access_hidden path /v1/challenge /v1/verify /v1/access-token /healthz /readyz
    handle @neal_access_hidden {
        header Content-Type "application/json; charset=utf-8"
        header Cache-Control "no-store"
        respond `{"error":"Not found"}` 404
    }

    handle {
        reverse_proxy synapse:8008
    }
}
