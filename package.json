{
  "name": "neal-launch-program",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "launcher:wasm": "wasm-pack build crates/launch-wasm --target web --out-dir ../../apps/launcher/src/wasm-pkg",
    "launcher:sync": "npm run sync -w @neal/launch-console",
    "launcher:dev": "npm run launcher:wasm && npm run dev -w @neal/launch-console",
    "launcher:typecheck": "npm run typecheck -w @neal/launch-console",
    "launcher:build": "npm run launcher:wasm && npm run build -w @neal/launch-console",
    "launcher:verify-assets": "node scripts/verify-launch-assets.mjs",
    "launcher:simulate": "node scripts/simulate-launch-preflight.mjs",
    "launcher:stage": "node scripts/stage-launch-review.mjs",
    "launcher:record": "node scripts/record-launch-receipt.mjs",
    "site:sync": "npm run sync -w @neal/public-site",
    "site:dev": "npm run dev -w @neal/public-site",
    "site:typecheck": "npm run typecheck -w @neal/public-site",
    "site:validate-policy": "node scripts/validate-wallet-policy.mjs",
    "site:manage-access-stake": "node scripts/manage-access-stake-config.mjs",
    "site:build": "npm run build -w @neal/public-site",
    "access-stake:reproduce": "node scripts/reproduce-access-stake-release.mjs",
    "access-stake:rehearse-devnet": "node scripts/rehearse-access-stake-devnet.mjs",
    "access-stake:validate-evidence": "node scripts/validate-access-stake-evidence.mjs",
    "access-stake:test-tooling": "node --test scripts/access-stake-tooling.test.mjs"
  }
}
